# Chess NginC API — example configuration (apps/api/.env)
#
# Copy to `.env` and adjust. `app.core.database.Settings` reads exactly these
# keys (case-insensitive). Every advertised setting is listed here so this file
# and `Settings` never drift again. Secrets are never committed: keep `.env`
# out of git and inject real values via the environment in production.

# --- Runtime & secrets -------------------------------------------------------
# development | production. In production a placeholder SECRET_KEY refuses boot.
APP_ENV=development
# Used as the HMAC key for recovery-token derivation (ADR). Set a unique value
# in production; never reuse the placeholder.
SECRET_KEY=change-me-in-development-only
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Compose injects its own value; local runs point at a PostgreSQL you own.
DATABASE_URL=postgresql+psycopg://chess:chess@localhost:5432/chess_engine
# Connection pool (REL-008). Sized for the single-worker API process; pre_ping
# transparently recovers from server-side connection resets.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- Cookies & CORS ----------------------------------------------------------
# Serve the session cookie with the Secure flag (set true only behind TLS).
COOKIE_SECURE=false
# Comma-separated allowlist; also the CSRF same-origin reference.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_HOURS=336

# --- Rate limiting (SEC-012/013) --------------------------------------------
# Split buckets per route class so one class cannot starve another.
AUTH_RATE_LIMIT_PER_MINUTE=10
ENGINE_RATE_LIMIT_PER_MINUTE=60
WRITE_RATE_LIMIT_PER_MINUTE=120
# When behind nginx, the comma/CIDR list of proxy IPs whose X-Forwarded-For may
# be trusted for the real client address. Empty = direct exposure (never trust it).
FORWARDED_ALLOW_IPS=

# --- Engine provider seam (Phase 2) -----------------------------------------
# stockfish_remote | stockfish_local | custom
ENGINE_BACKEND=custom
ENGINE_BASE_URL=http://engine:8050
ENGINE_CONNECT_TIMEOUT_MS=3000
ENGINE_READ_TIMEOUT_MS=8000
ENGINE_MAX_CONCURRENCY=2
ENGINE_MAX_CONCURRENCY_PER_USER=1
ENGINE_CIRCUIT_FAILURE_THRESHOLD=3
ENGINE_CIRCUIT_COOLDOWN_SECONDS=30

# --- Local / hosted Stockfish ------------------------------------------------
# Absolute binary path; empty = PATH lookup. Never taken from a client.
STOCKFISH_PATH=
STOCKFISH_DEPTH_LIMIT=15
STOCKFISH_TIME_LIMIT_MS=1000
# Cloud fallback (stockfishapi.com); empty key disables it. Never log or echo it.
STOCKFISH_API_KEY=
STOCKFISH_API_BASE_URL=https://stockfishapi.com/v1

# --- Account recovery (SEC-013) ---------------------------------------------
# With no SMTP_HOST the ConsoleEmailSender logs verify/reset URLs, so local dev
# needs zero configuration. Set these to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Public origin used to build clickable verify/reset links. Empty falls back to
# the request origin.
PUBLIC_WEB_BASE_URL=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
