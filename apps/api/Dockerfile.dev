# Chess Engine API — development image (local dev only).
# Installs the Stockfish binary so engine moves + benchmarks work out of the box.
# GPL-3.0 (REL-011): the binary is installed from the distro at build time and is
# NOT redistributed by this repo. Production intentionally omits it (see Dockerfile).
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Stockfish from Debian/Ubuntu packages (BEN-001). Dev-only convenience layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/api

# Install runtime deps first for layer caching.
COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir .

# Migrations ship with the image; applied by the one-shot `migrate` service.
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Unprivileged runtime user, mirroring the production image.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin apiuser \
    && chown -R apiuser:apiuser /srv/api
USER apiuser

EXPOSE 8000

# Serve only (migrations run as a separate service). Proxy headers keep the
# real client address for rate limiting behind nginx (SEC-012).
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:-172.16.0.0/12}\""]