# Backup + restore-test schedule (REL-004/REL-005).
#
# The whole point: chain verify-backup.sh straight after backup-db.sh, so a
# silent corruption shows up as a FAIL in the log the same night — not during
# the outage you were counting on the backup to survive. Exit code is non-zero
# on any failure, so a monitor (healthchecks.io ping, cron mail, alerting) on
# this job's success is your backup-failure alarm (deployment.md §8 lists it).
#
# ── Linux (crontab -e), DB in Compose, dumps pushed off-host ──────────────────
#   minute hour dom mon dow  command
0 3 * * *  cd /srv/chess-ninc && DB_IN_CONTAINER=1 RCLONE_TARGET=s3:chess-backups ./scripts/backup-db.sh && ./scripts/verify-backup.sh >> /var/log/chess-backup.log 2>&1
#
# ── Weekly base backup for PITR (pair with compose.pitr.yaml archiving) ───────
0 4 * * 0  cd /srv/chess-ninc && DB_IN_CONTAINER=1 RCLONE_TARGET=s3:chess-backups ./scripts/pitr-basebackup.sh >> /var/log/chess-backup.log 2>&1
#
# ── Monthly restore DRILL (the check people skip, then wish they hadn't) ─────
# Verify from the OLDEST kept backup, not just the newest — proves retention
# still loads, not just the file you made last night.
0 5 1 * *  cd /srv/chess-ninc && OLDEST=$(ls -t ./backups/*.dump | tail -1) && ./scripts/verify-backup.sh "$OLDEST" >> /var/log/chess-backup.log 2>&1
#
# ── macOS (this dev box): use launchd, not cron ──────────────────────────────
# Drop ~/Library/LaunchAgents/com.chess.backup.plist running:
#   /bin/bash -c 'cd "<repo>" && ./scripts/backup-db.sh && ./scripts/verify-backup.sh'
# with StartCalendarInterval at 03:00, then `launchctl load` it. (cron is
# deprecated on macOS and misses runs when the laptop is asleep.)
