# pgBackRest configuration for Chess NginC Postgres — the production PITR path.
#
# WHY THIS OVER archive_command + pg_basebackup once real users exist: pgBackRest
# gives you encryption at rest, retention pruning, incremental/differential
# backups, parallel streams, and an automatic archive-push/pull that survives a
# full disk — the pieces the plain WAL-copy setup lacks.
#
# Install `pgbackrest` in the db image (or a sidecar sharing the socket+pgdata),
# then:
#   pgbackrest --stanza=chess stanza-create
#   pgbackrest --stanza=chess check                     # verify archiving works
#   pgbackrest --stanza=chess backup                     # full
#   pgbackrest --stanza=chess backup --type=incr
#   pgbackrest --stanza=chess restore \
#       --type=time "--target=2026-10-26 03:00:00+00" --delta
#
# And in postgresql.conf (compose.pitr.yaml already sets wal_level=replica):
#   archive_command = 'pgbackrest --stanza=chess archive-push %p'
#
# Secrets (repo-s3-key*, cipher-pass) come from the environment / secret store —
# never commit this file with real values. This is an EXAMPLE.

[global]
repo-type=s3
repo-s3-endpoint=s3.amazonaws.com
repo-s3-region=us-east-1
repo-s3-bucket=chess-backups
repo-s3-key=${AWS_ACCESS_KEY_ID}
repo-s3-key-secret=${AWS_SECRET_ACCESS_KEY}

# Retention + at-rest encryption (the two things a bare pg_dump lacks).
repo-retention-full=14
repo-retention-full-type=time
cipher-type=passfix
cipher-pass=${PGBACKREST_CIPHER_PASS}

log-level-console=info
log-level-file=detail

[stanza:chess]
pg1-path=/var/lib/postgresql/data
spool-path=/var/spool/pgbackrest
