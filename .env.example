# Copy to .env and fill in local, non-secret values. Never commit .env or real secrets.

# --- Application ---
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-development-only
# Comma-separated list of allowed origins for the web app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true only behind TLS in production.
COOKIE_SECURE=false

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chess_engine
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://chess:change-me-local-only@localhost:5432/chess_engine

# --- Stockfish ---
# Absolute path to the binary. Never accept a path from clients (BEN-020).
# Leave EMPTY for auto-detection: PATH lookup first, then the distro package
# locations the adapter probes (/usr/games/stockfish, /usr/bin, /usr/local/bin,
# /opt/homebrew/bin). Both container images install the `stockfish` package, so
# the computer opponent and game review work with this left empty. Set it only
# for a locally built binary or a non-standard install.
# Running the API directly on a host (uvicorn, no Docker) needs a real binary
# there too — e.g. `brew install stockfish` on macOS.
STOCKFISH_PATH=
STOCKFISH_DEPTH_LIMIT=15
STOCKFISH_TIME_LIMIT_MS=1000
# Hosted Stockfish (stockfishapi.com). Used as the cloud fallback: the engine
# factory tries the local binary first and only reaches this API when no binary
# is available (or when STOCKFISH_PATH points to a missing file). Compose
# forwards both values into the api container, so running `docker compose up`
# is enough. If you also run `uvicorn` from the host without Docker, mirror
# these two lines in `apps/api/.env` — pydantic-settings loads that file
# relative to the uvicorn cwd, not this root one. NEVER commit a real key.
STOCKFISH_API_KEY=
STOCKFISH_API_BASE_URL=https://stockfishapi.com/v1

# --- Engine resource limits ---
ENGINE_MAX_DEPTH=6
ENGINE_MAX_TIME_MS=3000
ENGINE_MAX_CONCURRENCY=2

# --- Logging ---
LOG_LEVEL=INFO

# --- Google Sign-In (optional) ---
# OAuth 2.0 Web client ID from Google Cloud Console (authorized origin:
# the web app origin). Used by both the API (verification) and the web
# bundle (button). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- Password reset email (optional) ---
# Base origin of the link emailed to users. Without SMTP_HOST the reset
# link is written to the API log instead (development convenience; set a
# real SMTP provider in production).
RESET_LINK_BASE=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Coach assistant (Phase 11, optional) ---
# The ⭐ coach on the review page answers from engine + book facts about the
# player's own games. It is fully functional with NO key: leave ASSISTANT_API_KEY
# empty and every answer comes from the deterministic engine-grounded path. Set a
# key only to let an OpenAI-compatible model rephrase those same cited facts; the
# grounding guard discards any reply that names a move it cannot cite. NEVER
# commit a real key.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_MAX_TOKENS=400
# In-process per-user throttle on the ask endpoint (abuse backstop, not auth).
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# RAG recall tuning: rows pulled per query, and the minimum errors before an
# opening family surfaces in "what do I keep doing wrong".
COACH_RECALL_TOP_K=6
COACH_PATTERNS_MIN=2

# --- ElevenLabs TTS (optional; free tier = 10,000 chars/month, no card) ---
# Sign up at https://elevenlabs.io and paste your API key here. The key is
# read ONLY by the FastAPI backend (never exposed to the browser). When the
# key is empty the frontend silently falls back to the browser's built-in
# speechSynthesis engine — no configuration required for basic narration.
# Free voices that work with a free-tier key: Rachel  21m00Tcm4TlvDq8ikWAM,
# Adam  pNInz6obpgDQGcFmaJgB, Bella  EXAVITQu4vr4xnSDxMaL,
# Antoni  9BWtsMINqrJLrRACOkcd, Domi  AZnzlkYeXb6Sdi69b0pD.
# eleven_flash_v2_5 is the cheapest/fastest model; eleven_multilingual_v2
# offers more expression at roughly 2× the character cost.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# --- Monitoring & rate limiting (Phase 12A, D14/D15) ---
# Per-surface abuse budgets (in-process sliding windows; RL-001/002). Every 429
# carries a Retry-After header. A review holds a warm engine for seconds of CPU,
# so it is budgeted per HOUR and a forced re-run (POST review with force=true)
# costs 2 units. Training attempts write ledger rows, so they get a per-minute
# ceiling.
REVIEW_RATE_LIMIT_PER_HOUR=10
TRAINING_RATE_LIMIT_PER_MINUTE=60
# Shared hosted-engine daily pot in estimated API units (stockfishapi.com free
# tier is 2,000 units/day for the WHOLE account). The local guard trips before
# upstream 429/402 does; 0 disables it. Only consulted on the cloud engine route
# (D7 local-first), so dormant while a local Stockfish binary is available.
CLOUD_DAILY_UNIT_BUDGET=1800
# MON-001: log format. true (default) = JSON lines with a per-request request_id
# (also echoed in the X-Request-ID response header); false = plain text lines.
# Nothing ever logs tokens, passwords, API keys, or session ids.
LOG_JSON=true
