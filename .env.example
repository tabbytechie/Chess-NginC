# Copy to .env and fill in local, non-secret values. Never commit .env or real secrets.

# --- Application ---
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-development-only
# Comma-separated list of allowed origins for the web app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true only behind TLS in production.
COOKIE_SECURE=false

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chess_engine
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://chess:change-me-local-only@localhost:5432/chess_engine

# --- Stockfish (optional; leave empty if not installed) ---
# Absolute path to the Stockfish binary. Never accept a path from clients.
# Production: leave empty (no binary shipped; Stockfish stays optional).
# Development with compose.dev.yaml: set to /usr/games/stockfish (the Debian/
# Ubuntu package path in the dev image) so engine moves + benchmarks work.
STOCKFISH_PATH=
STOCKFISH_DEPTH_LIMIT=15
STOCKFISH_TIME_LIMIT_MS=1000
# Hosted Stockfish API (stockfishapi.com) — cloud engine, no binary needed.
# NEVER commit a real key here. Copy to .env only. Free plan: depth ≤14.
STOCKFISH_API_KEY=
STOCKFISH_API_BASE_URL=https://stockfishapi.com/v1

# --- Engine provider seam (Phase 2) ---
# Opponent backend: stockfish_remote (private sidecar, production),
# stockfish_local (a Stockfish binary on PATH / STOCKFISH_PATH, dev), or
# custom (in-process fallback, always available). Difficulty budgets
# (easy/medium/hard) are mapped server-side to depth/time and clamped by the
# backend's hard bounds; clients can no longer request depth or time.
ENGINE_BACKEND=custom
# Sidecar base URL when ENGINE_BACKEND=stockfish_remote (compose sets this).
ENGINE_BASE_URL=http://engine:8050
ENGINE_CONNECT_TIMEOUT_MS=3000
ENGINE_READ_TIMEOUT_MS=8000
# Global + per-user concurrent search cap; saturation returns 503 + Retry-After.
ENGINE_MAX_CONCURRENCY=2
ENGINE_MAX_CONCURRENCY_PER_USER=1
# Circuit breaker: after this many consecutive backend failures, fall back to
# the custom engine for the cooldown window (seconds) and log one warning.
ENGINE_CIRCUIT_FAILURE_THRESHOLD=3
ENGINE_CIRCUIT_COOLDOWN_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
